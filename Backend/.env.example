# Copy to .env and adjust. Nothing here is required for local development: every value has a default.

# --- Server ---------------------------------------------------------------------------------------
# development | test | production. Production requires JWT_SECRET and listens on 127.0.0.1 only.
NODE_ENV=development
# Port the API listens on.
PORT=4000
# Interface to bind (default: all interfaces in dev, 127.0.0.1 in production).
# HOST=0.0.0.0
# Comma-separated browser origins allowed to call the API (the web app in dev). Use * to allow any (dev only).
CORS_ORIGIN=http://localhost:5173

# --- Database -------------------------------------------------------------------------------------
# Leave EMPTY to use the embedded dev database (mongodb-memory-server) stored in .data/mongo — nothing to install.
# Set to a real connection string only when deploying, e.g. mongodb://user:pass@host:27017/mydiary
MONGODB_URI=
# Port of the embedded dev database (only used when MONGODB_URI is empty).
EMBEDDED_MONGO_PORT=27018

# --- Auth -----------------------------------------------------------------------------------------
# Secret used to sign login tokens. REQUIRED in production; dev falls back to a fixed value. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# How long a login token stays valid (jsonwebtoken format: 7d, 12h, 30m).
JWT_EXPIRES=7d

# --- First admin (created once, only when the users collection is empty) --------------------------
ADMIN_NAME=Venkata Cherukuri
ADMIN_EMAIL=venkata.cherukuri@trustlab.co.in
# Change this before the first boot on a real database.
ADMIN_PASSWORD=mydiary123

# --- Seed (npm run seed) --------------------------------------------------------------------------
# Password given to every roster account created by the seed (also used when POST /api/users omits password).
SEED_PASSWORD=mydiary123

# Push notifications (Firebase Cloud Messaging).
# Points at the Firebase service-account key. Leave it unset and push is simply off: in-app
# notifications are still written, nothing errors. The file is a private key — keep it out of git
# (storage/firebase/ is already ignored).
FCM_CREDENTIALS=storage/firebase/trustlab-diagnostics-firebase-adminsdk-fbsvc-34e59ee200.json

# --- Lab Readiness evidence photographs -----------------------------------------------------------
# Where the opening / closing photographs and sign-off pictures go. Fill in all three S3 values and
# they are written to the bucket; leave any of them blank and they go to UPLOAD_DIR on this machine
# instead, so a developer needs no credentials. Use v1's bucket, so both apps' evidence sits together.
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only for an S3-compatible service that is not AWS (MinIO, Wasabi…). Leave blank for AWS.
S3_ENDPOINT=
# Local fallback directory, relative to Backend/ (gitignored).
UPLOAD_DIR=.data/uploads
# The bucket folders, matching v1 exactly — including the spelling of "lab-openeings", which is how
# the folder was created there. Only change these if v1's folders are ever renamed.
LAB_READINESS_FOLDER_OPENING=lab-openeings
LAB_READINESS_FOLDER_CLOSING=lab-closings
LAB_READINESS_FOLDER_SIGNOFF=sign-off-pics

# --- PACE identity hub -------------------------------------------------------
# Shared secret PACE sends on the X-Provisioning-Token header when it creates or
# disables an account here. Must match the token set in PACE
# (Admin -> Settings -> Provisioning, or PROVISIONING_TOKEN in its .env).
# Generate one with:  openssl rand -hex 32
# Leave blank and /api/provisioning answers 503, which PACE shows to HR as
# "Not set up for provisioning yet."
PROVISIONING_TOKEN=
